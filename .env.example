# =========================================================================
# Nex Digital — Full-Stack 2 Test
# Copy this file to `.env` and adjust values for your environment.
# `docker compose up` reads from this file when `.env` is absent.
# =========================================================================

# ---- Database (MySQL 8) ----
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=nex
MYSQL_USER=nex
MYSQL_PASSWORD=change-me-mysql-pass
MYSQL_ROOT_PASSWORD=change-me-root-pass

# ---- API ----
API_PORT=3000
NODE_ENV=development
API_LOG_LEVEL=info
API_CORS_ORIGIN=http://localhost:5173

# JWT — generate with `openssl rand -base64 64`
JWT_SECRET=replace-me-with-a-64-byte-random-string
JWT_EXPIRES_IN=15m

# LGPD encryption keys — generate with `openssl rand -hex 32`
# AES-256-GCM data key (must be 64 hex chars = 32 bytes)
LGPD_DATA_KEY=replace-me-32-byte-hex-key-replace-me-32-byte-hex-key-aabbccdd
# HMAC pepper for CPF lookup index (any 64+ char string)
LGPD_HMAC_PEPPER=replace-me-with-a-long-random-pepper-string

# Admin seed (created by db:seed)
ADMIN_EMAIL=admin@nex.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Administrator
ADMIN_CPF=000.000.000-00

# Rate limit (requests per minute)
RATE_LIMIT_AUTH=5
RATE_LIMIT_GLOBAL=100

# ---- Web ----
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:3000/api
